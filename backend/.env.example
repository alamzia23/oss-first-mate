# ─── Anthropic ────────────────────────────────────────────────────────────────
# Required. Your Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── GitHub (via Coral) ───────────────────────────────────────────────────────
# Required. GitHub personal access token with `repo` read scope.
# This is passed to Coral when running: coral source add github
# Coral reads it from your environment at query time.
GITHUB_TOKEN=ghp_...

# ─── Slack (via Coral) ────────────────────────────────────────────────────────
# Required. The Slack channel ID to pull messages from.
# Find it by right-clicking a channel in Slack → View channel details → scroll to bottom.
SLACK_CHANNEL_ID=C057H0PF3PG

# ─── Server ───────────────────────────────────────────────────────────────────
# Optional. Port the Express backend listens on. Defaults to 3001.
PORT=3001
